# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# Coverage
.coverage
.coverage.*
coverage_report*.txt
htmlcov/

# Local environment
.env

# Streaming broker / cluster runtime data (regenerated by Docker)
kafka_data/
redis_cluster/
redis_data/

# LaTeX build byproducts (regenerated by pdflatex/bibtex)
*.aux
*.bbl
*.blg
*.out
*.synctex.gz
*.toc
# Lists of figures and tables, written by the \listoffigures and \listoftables in the
# supplement. Build artifacts, like the .toc above them.
*.lof
*.lot
*.fls
*.fdb_latexmk
/manuscript.log

# Stray shell-redirect artifact
$null

# Raw StatsBomb event JSONs (re-fetchable via scripts/fetch_statsbomb_events.sh)
data/raw/statsbomb/*/events/

# Bulky regenerable per-run outputs (orchestrators regenerate; aggregates kept in docs/results/)
runs/concurrency_*/
runs/batch9*/
runs/_concurrency_*_runs.txt
runs/_fair_*sweep.log
runs/_fullmatch_single.log
runs/fairtest_*/

# Raw per-run output. 7.9 GB and ~2,000 files when tracked, which made the repository
# unarchivable and the reproducibility claim hollow. The evidence the paper cites lives in the
# aggregated CSVs under docs/results/, which ARE tracked and which the consistency tests pin;
# the raw runs are regenerable from the campaign scripts in cloud/campaigns/.
runs/

# Superseded Testbed A corpus (withdrawn in full -- see paper Section 6.7). Kept on disk as
# provenance for the audit's rejection counts, not tracked.
docs/results/concurrency_concurrency_*/

# Cloud testbed addresses (ephemeral, per-provisioning), one file per machine pair
cloud/hosts.env
cloud/hosts_b.env
cloud/hosts_arm.env
paper.aux
paper.log
paper.out
paper.bbl
paper.blg

# Bulk run data pulled off the cloud driver before the VMs are released.
# The tracked summary of every run is reproducibility/runs_index*.csv and
# run_metadata*.jsonl.gz; this is the raw evidence behind it, ~800 MB.
cloud_archive/

# Deposit bundles built by scripts/zenodo_deposit.py, and the supplement's build log
# (paper.log is above; campaign .log files under reproducibility/ stay tracked)
dist/
supplement.log

# Third-party PDFs fetched for vocabulary statistics; never committed (public repository).
docs/reference_corpus/

# Third-party IEEE Transactions on Computers papers, downloaded during review to settle
# questions of house norm and vocabulary. They are other people's copyrighted work:
# readable under whatever each publisher granted, redistributable under none of it. The
# Zenodo bundle excludes this directory for exactly that reason
# (scripts/zenodo_deposit.py, NC_DERIVED_PATHS); a public git remote is the same exposure.
docs/reference_tc/

# Derived build outputs: the collision rasters and the author-free PDFs that go to
# Zenodo and into attachments. Both are rebuilt deterministically by their own scripts
# (show_figure_collisions.py, build_without_authors.py), and a committed copy of a
# derived PDF is one more thing that can drift from the source it was made from.
build/

# The Java harness for A8: its jars are fetched by build.sh and pinned by their fingerprints in
# harness/java/DEPENDENCIES, and its classes are built from src/. Neither is source.
harness/java/lib/
harness/java/out/

# The copy the queue loop runs from, so a pull cannot rewrite the script bash is reading
cloud/azure/.queue.running.sh
