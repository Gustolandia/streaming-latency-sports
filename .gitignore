# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# Coverage
.coverage
.coverage.*
coverage_report*.txt
htmlcov/

# Local environment
.env

# Streaming broker / cluster runtime data (regenerated by Docker)
kafka_data/
redis_cluster/
redis_data/

