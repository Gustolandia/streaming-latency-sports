cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: "Faster-than-Light: code and analysis for latency measurement artifacts in streaming benchmarks"
# Order matches the manuscript byline and is not alphabetical: lead author first. The list
# held four names until 2026-09-10, when the last author's withdrawal of 8 September was
# actioned and a third author asked to be removed from the work. Neither is named here.
# The one ORCID is Ricou's, from his own arXiv account; Duvignau's is absent rather than
# guessed, which is the same rule the biographies follow.
authors:
  - family-names: "Ricou"
    given-names: "Gustavo Pedro"
    email: "pedrorig@tcd.ie"
    affiliation: "School of Computer Science and Statistics, Trinity College Dublin"
    orcid: "https://orcid.org/0009-0001-4196-7213"
  - family-names: "Duvignau"
    given-names: "Romaric"
    email: "duvignau@chalmers.se"
    affiliation: "Department of Computer Science and Engineering, Chalmers University of Technology"
abstract: "Two failure modes of sub-millisecond latency benchmarking: causality-violating inversions from scheduling stalls, and silent sample deletion governed by a grid law in the send-interval-to-timestamp-quantum ratio. Code, campaigns, and a suite that recomputes every figure from committed data."
version: "3.0.0"
url: "https://github.com/Gustolandia/streaming-latency-sports"
doi: "10.5281/zenodo.21650031"   # concept DOI: always the latest version
license: "MIT"
keywords:
  - streaming systems
  - real-time analytics
  - sports data
  - apache kafka
  - redis streams
  - latency benchmarking
  - time-to-insight
  - actionability windows
  - football analytics
  - reproducible research
date-released: "2026-09-04"
# The paper. Under CFF the top-level block above already describes the software, so this key
# describes the work a reader should cite instead -- and there must be exactly one of it. There
# were two, and because CFF is YAML the second silently overwrote the first: the paper citation
# was discarded at parse time and "Cite this repository" emitted a scaffolding version instead.
preferred-citation:
  type: article
  title: "Faster-than-Light: Latency Measurement Artifacts in Streaming Benchmarks"
  authors:
    - family-names: "Ricou"
      given-names: "Gustavo Pedro"
      affiliation: "School of Computer Science and Statistics, Trinity College Dublin"
    - family-names: "Duvignau"
      given-names: "Romaric"
      affiliation: "Department of Computer Science and Engineering, Chalmers University of Technology"
  journal: "IEEE Transactions on Computers"
  year: 2026
  volume: "TBD"
  issue: "TBD"
  pages: "TBD"
  # doi: publisher DOI, filled in on acceptance (the Zenodo DOI above is the software's)
  # url: filled in on acceptance

