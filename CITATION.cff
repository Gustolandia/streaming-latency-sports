cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: "Faster Than Light, According to the Arithmetic: two failure modes of streaming latency measurement"
# Order matches the manuscript byline and is not alphabetical: lead author first, the two
# middle places by how far into the argument each contribution reached, and Gregg last in the
# senior slot. Herbst's ORCID is the only one held first-party; the others are absent rather
# than guessed, which is the same rule the biographies follow.
authors:
  - family-names: "Ricou"
    given-names: "Gustavo Pedro"
    email: "pedrorig@tcd.ie"
    affiliation: "School of Computer Science and Statistics, Trinity College Dublin"
    # orcid: "https://orcid.org/0000-0000-0000-0000"   # add your ORCID if you have one
  - family-names: "Duvignau"
    given-names: "Romaric"
    email: "duvignau@chalmers.se"
    affiliation: "Department of Computer Science and Engineering, Chalmers University of Technology"
  - family-names: "Herbst"
    given-names: "Nikolas"
    email: "nikolas.herbst@uni-wuerzburg.de"
    affiliation: "Chair of Computer Science II, University of Würzburg"
    orcid: "https://orcid.org/0000-0003-3462-6426"
  - family-names: "Gregg"
    given-names: "David"
    email: "david.gregg@tcd.ie"
    affiliation: "School of Computer Science and Statistics, Trinity College Dublin"
abstract: "Two failure modes of sub-millisecond latency benchmarking: causality-violating inversions from scheduling stalls, and silent sample deletion governed by a grid law in the send-interval-to-timestamp-quantum ratio. Code, campaigns, and a suite that recomputes every figure from committed data."
version: "3.0.0"
url: "https://github.com/Gustolandia/streaming-latency-sports"
doi: "10.5281/zenodo.21650031"   # concept DOI: always the latest version
license: "MIT"
keywords:
  - streaming systems
  - real-time analytics
  - sports data
  - apache kafka
  - redis streams
  - latency benchmarking
  - time-to-insight
  - actionability windows
  - football analytics
  - reproducible research
date-released: "2026-09-04"
# The paper. Under CFF the top-level block above already describes the software, so this key
# describes the work a reader should cite instead -- and there must be exactly one of it. There
# were two, and because CFF is YAML the second silently overwrote the first: the paper citation
# was discarded at parse time and "Cite this repository" emitted a scaffolding version instead.
preferred-citation:
  type: article
  title: "Faster Than Light, According to the Arithmetic: Two Ways a Streaming Benchmark Fails on Sub-Millisecond Paths"
  authors:
