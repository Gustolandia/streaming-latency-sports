\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Both failures on one population.} The $738{,}730$ messages of our corpus, timed on one clock. (a)~Timed from the broker's acknowledgment, $62{,}264$ of them come out negative (red). Timed from the publish call, none does. (b)~The acknowledgment-timed spans of (a) as a millisecond timestamp would record them. A span shorter than a millisecond computes to $0$ or $1$~ms. A filter that keeps only positive values, a rule several tools apply (Section~\ref {sec:external}), would delete $45.8\%$ of them without a count.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:twoways}{{2}{3}{\textbf {Both failures on one population.} The $\spanEvents $ messages of our corpus, timed on one clock. (a)~Timed from the broker's acknowledgment, $\spanNegAck $ of them come out negative (red). Timed from the publish call, none does. (b)~The acknowledgment-timed spans of (a) as a millisecond timestamp would record them. A span shorter than a millisecond computes to $0$ or $1$~ms. A filter that keeps only positive values, a rule several tools apply (Section~\ref {sec:external}), would delete $\msGuardDeletedPct \%$ of them without a count}{figure.2}{}}
