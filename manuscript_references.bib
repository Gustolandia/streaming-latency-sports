@misc{tene2015latency,
  title={How {NOT} to Measure Latency},
  author={Tene, Gil},
  year={2015},
  note={Coined ``coordinated omission'': a load generator whose measurement
        thread blocks during a stall never takes the samples that would have
        been worst, so reported percentiles are optimistic by orders of
        magnitude. The failure reported in Section~\ref{sec:external} is its
        mirror image --- the samples are taken and then discarded downstream.
        Talk, Strange Loop / QCon.}
}

